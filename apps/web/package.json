{
  "name": "web",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings 0",
    "format": "prettier --write . --ignore-path ../../.gitignore --ignore-path ../../.prettierignore",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "visual": "playwright test --project=visual",
    "e2e:smoke": "playwright test --project=chromium --grep @smoke --workers=2 --max-failures=1 && playwright test --project=a11y --workers=2 --max-failures=1"
  },
  "dependencies": {
    "@hookform/resolvers": "7.0.3",
    "@workspace/ui": "workspace:*",
    "lucide-react": "catalog:",
    "next": "16.4.5",
    "next-themes": "^0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "recharts": "catalog:",
    "themercn": "workspace:*",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/culori": "4.0.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "@workspace/eslint-config": "workspace:^",
    "@workspace/typescript-config": "workspace:*",
    "culori": "4.0.2",
    "eslint": "^10.14.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
