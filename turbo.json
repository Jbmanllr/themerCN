{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build:css": {
      "outputs": []
    },
    "build": {
      "dependsOn": ["^build", "build:css"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "dist/**"]
    },
    "check:package": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "lint": {},
    "format": {
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["^typecheck", "build:css"]
    },
    "test": {
      "dependsOn": ["^build", "build:css"]
    },
    "e2e": {
      "dependsOn": ["build"],
      "passThroughEnv": ["WEB_E2E_PORT", "VITE_E2E_PORT", "PLAYWRIGHT_BROWSERS_PATH"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
