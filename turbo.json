{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "futureFlags": {
    "affectedUsingTaskInputs": true
  },
  "tasks": {
    "build:css": {
      "outputs": []
    },
    "build": {
      "dependsOn": ["^build", "build:css"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "dist/**"]
    },
    "check:package": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "lint": {},
    "format": {
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["^typecheck", "^build", "build:css"]
    },
    "test": {
      "dependsOn": ["^build", "build:css"]
    },
    "e2e": {
      "dependsOn": ["build"],
      "env": ["CI"],
      "passThroughEnv": [
        "WEB_E2E_PORT",
        "VITE_E2E_PORT",
        "PLAYWRIGHT_BROWSERS_PATH"
      ]
    },
    "e2e:smoke": {
      "dependsOn": ["build"],
      "env": ["CI"],
      "passThroughEnv": [
        "WEB_E2E_PORT",
        "VITE_E2E_PORT",
        "PLAYWRIGHT_BROWSERS_PATH"
      ]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    }
  }
}
