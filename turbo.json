{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build:css": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.test.{ts,tsx}",
        "!e2e/**",
        "!**/__snapshots__/**",
        "!**/*-snapshots/**",
        "!*.md",
        "!vitest.config.*",
        "!playwright.config.*"
      ],
      "outputs": []
    },
    "build": {
      "dependsOn": ["^build", "build:css"],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "!**/*.test.{ts,tsx}",
        "!e2e/**",
        "!**/__snapshots__/**",
        "!**/*-snapshots/**",
        "!*.md",
        "!vitest.config.*",
        "!playwright.config.*"
      ],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "dist/**"]
    },
    "check:package": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "lint": {},
    "format": {
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["^typecheck", "^build", "build:css"]
    },
    "test": {
      "dependsOn": ["^build", "build:css"],
      "env": ["CI"]
    },
    "e2e": {
      "dependsOn": ["build"],
      "env": ["CI"],
      "passThroughEnv": [
        "WEB_E2E_PORT",
        "VITE_E2E_PORT",
        "PLAYWRIGHT_BROWSERS_PATH"
      ],
      "outputs": ["playwright-report/**", "test-results/**"]
    },
    "e2e:smoke": {
      "dependsOn": ["build"],
      "env": ["CI"],
      "passThroughEnv": [
        "WEB_E2E_PORT",
        "VITE_E2E_PORT",
        "PLAYWRIGHT_BROWSERS_PATH"
      ],
      "outputs": ["playwright-report/**", "test-results/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    }
  }
}
