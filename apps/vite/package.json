    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "^10",
    "tailwindcss": "^4.3.3",
    "typescript": "^5",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
