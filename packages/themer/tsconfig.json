{
  // The one config for the package: `typecheck`, editors (tests included)
  // and tsdown's declarations (which only reach the entries' imports).
  // `allowJs` lets the script tests import the build scripts (.mjs).
  "extends": "@workspace/typescript-config/react-library.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "declarationMap": false,
    "allowJs": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "scripts/**/*.test.ts"]
}
