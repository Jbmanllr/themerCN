{
  "name": "@villa/themer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./components/*": "./src/components/*.tsx",
    "./hooks/*": "./src/hooks/*.ts",
    "./stores/*": "./src/stores/*.ts",
    "./storage/*": "./src/storage/*.ts",
    "./utils/*": "./src/utils/*.ts",
    "./config/*": "./src/config/*.ts",
    "./types": "./src/types/index.ts",
    "./api/*": "./src/api/*.ts",
    "./host/flag": "./src/host/flag.ts",
    "./host/font-catalog-route": "./src/host/font-catalog-route.ts",
    "./host/gate": "./src/host/gate.tsx",
    "./host/head-script": "./src/host/head-script.tsx",
    "./host/passthrough": "./src/host/passthrough.tsx",
    "./host/themer.css": "./src/host/themer.css"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/modifiers": "9.0.0",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-table": "9.2.5",
    "culori": "4.0.2",
    "date-fns": "4.4.0",
    "idb-keyval": "6.3.0",
    "lenis": "1.3.26",
    "lucide-react": "1.52.0",
    "next": "16.4.0",
    "next-themes": "0.4.6",
    "react-day-picker": "10.0.2",
    "react-resizable-panels": "4.14.2",
    "recharts": "3.10.1",
    "sonner": "2.0.8",
    "zod": "4.6.5",
    "zustand": "5.0.15",
    "@villa/ui": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/culori": "4.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  }
