{
  "name": "web",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings 0",
    "format": "prettier --write . --ignore-path ../../.gitignore --ignore-path ../../.prettierignore",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:smoke": "playwright test --project=chromium --grep @smoke --workers=2 && playwright test --project=a11y --workers=2"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.2",
    "@workspace/ui": "workspace:*",
    "lucide-react": "catalog:",
    "next": "16.4.0",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.90.0",
    "recharts": "catalog:",
    "themercn": "workspace:*",
    "zod": "4.6.7",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "^4",
    "@types/culori": "4.0.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@workspace/eslint-config": "workspace:^",
    "@workspace/typescript-config": "workspace:*",
    "culori": "4.0.2",
    "eslint": "^10",
    "typescript": "^5",
    "vitest": "^5.0.4",
    "yaml": "2.9.1"
  }
}
