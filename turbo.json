{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "futureFlags": {
    "affectedUsingTaskInputs": true
  },
  "tasks": {
    "build:css": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.test.{ts,tsx}",
        "!e2e/**",
        "!**/__snapshots__/**",
        "!**/*-snapshots/**",
        "!*.md",
        "!vitest.config.*",
        "!playwright.config.*"
      ],
      "outputs": []
    },
    "build": {
      "dependsOn": ["^build", "build:css"],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "!**/*.test.{ts,tsx}",
        "!e2e/**",
        "!**/__snapshots__/**",
        "!**/*-snapshots/**",
        "!*.md",
        "!vitest.config.*",
        "!playwright.config.*"
      ],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "dist/**"]
    },
    "check:package": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "lint": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/eslint-config/*.js"]
    },
    "//#lint:repo": {
      "inputs": [
        "tests/**",
        "vitest.config.ts",
        "eslint.config.mjs",
        "packages/eslint-config/*.js"
      ],
      "outputs": []
    },
    "format": {
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["^typecheck", "^build", "build:css"]
    },
    "test": {
      "dependsOn": ["^build", "build:css"],
      "env": ["CI"]
    },
    "//#test:repo": {
      "env": ["CI"],
      "inputs": [
        "tests/**",
        "vitest.config.ts",
        "tsconfig.json",
        ".claude/settings.json",
        ".claude/hooks/*",
        ".gitignore",
        ".prettierignore",
        ".github/workflows/ci.yml",
        "package.json",
        "pnpm-workspace.yaml",
        "README.md",
        "scripts/e2e-affected.sh",
        "turbo.json",
        "apps/*/package.json",
        "apps/*/turbo.json",
        "apps/*/eslint.config.js",
        "apps/*/playwright.config.ts",
        "apps/*/e2e/**/*.ts",
        "packages/*/package.json",
        "packages/*/turbo.json",
        "packages/*/eslint.config.js",
        "packages/eslint-config/*.js",
        "packages/typescript-config/*.json",
        "packages/ui/src/styles/globals.css",
        "packages/themer/src/styles/themer.css"
      ],
      "outputs": []
    },
    "e2e": {
      "dependsOn": ["build"],
      "env": ["CI"],
      "passThroughEnv": [
        "WEB_E2E_PORT",
        "VITE_E2E_PORT",
        "PLAYWRIGHT_BROWSERS_PATH"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.test.{ts,tsx}",
        "!vitest.config.*",
        "!**/__snapshots__/**"
      ],
      "outputs": ["playwright-report/**", "test-results/**"]
    },
    "visual": {
      "dependsOn": ["build"],
      "env": ["CI"],
      "passThroughEnv": [
        "WEB_E2E_PORT",
        "VITE_E2E_PORT",
        "PLAYWRIGHT_BROWSERS_PATH"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.test.{ts,tsx}",
        "!vitest.config.*",
        "!**/__snapshots__/**"
      ],
      "outputs": ["playwright-report/**", "test-results/**"]
    },
    "e2e:smoke": {
      "dependsOn": ["build"],
      "env": ["CI"],
      "passThroughEnv": [
        "WEB_E2E_PORT",
        "VITE_E2E_PORT",
        "PLAYWRIGHT_BROWSERS_PATH"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.test.{ts,tsx}",
        "!vitest.config.*",
        "!**/__snapshots__/**"
      ],
      "outputs": ["playwright-report/**", "test-results/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    }
  }
}
