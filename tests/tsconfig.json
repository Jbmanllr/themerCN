{
  // Type-checks the root's tests (run by `test:repo`), which import the apps'
  // Playwright configs and the shared ESLint configs by path.
  "extends": "@workspace/typescript-config/base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "noEmit": true,
    // The floor guard and the coverage command (tests/coverage.ts) run under
    // Node's type stripping, which needs the extension on their imports of
    // the register reader.
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": ["*.ts", "../vitest.config.ts"]
}
