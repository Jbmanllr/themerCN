{
  // Type-checks the root's tests (run by `test:repo`), which import the apps'
  // Playwright configs and the shared ESLint configs by path.
  "extends": "@workspace/typescript-config/base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "noEmit": true,
    // tests/coverage.ts runs under Node's type stripping (`pnpm coverage`),
    // which needs each import's .ts extension.
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": ["*.ts", "../vitest.config.ts"]
}
